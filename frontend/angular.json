{
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"credit-limit-playground-ui": {
			"projectType": "application",
			"root": "",
			"sourceRoot": "src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular-devkit/build-angular:application",
					"options": {
						"outputPath": "dist/credit-limit-playground-ui",
						"index": "src/index.html",
						"browser": "src/main.ts",
						"polyfills": [
							"zone.js"
						],
						"tsConfig": "tsconfig.app.json",
						"assets": [],
						"styles": [
							"src/styles.css"
						]
					},
					"configurations": {
						"production": {
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "development"
				},
				"serve": {
					"builder": "@angular-devkit/build-angular:dev-server",
					"options": {
						"proxyConfig": "proxy.conf.json"
					},
					"configurations": {
						"production": {
							"buildTarget": "credit-limit-playground-ui:build:production"
						},
						"development": {
							"buildTarget": "credit-limit-playground-ui:build:development"
						}
					},
					"defaultConfiguration": "development"
				}
			}
		}
	},
	"cli": {
		"analytics": "3b91edcf-aef4-4d04-a7b8-2e54ca353630"
	}
}